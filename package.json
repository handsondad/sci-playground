{
  "name": "sci-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "node tools/check-rules.mjs",
    "test": "node --test tests/*.test.mjs",
    "game:new": "node tools/new-game.mjs",
    "smoke": "node tools/smoke.mjs",
    "shots": "node tools/smoke.mjs --shots tmp-shots"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
